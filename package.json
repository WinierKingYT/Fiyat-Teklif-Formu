{
  "name": "v6-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:visual": "playwright test --grep \"visual baseline\"",
    "test:e2e:visual:update": "playwright test --grep \"visual baseline\" --update-snapshots",
    "test:e2e:performance": "playwright test --grep \"Performance guardrails\"",
    "test:e2e:ui": "playwright test --ui",
    "size": "npm run build && size-limit",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix"
    ]
  },
  "size-limit": [
    {
      "name": "Toplam JS (gzip)",
      "path": [
        "dist/assets/*.js"
      ],
      "gzip": true,
      "limit": "850 KB"
    },
    {
      "name": "html2pdf chunk (gzip)",
      "path": [
        "dist/assets/html2pdf-*.js"
      ],
      "gzip": true,
      "limit": "250 KB"
    },
    {
      "name": "CSS (raw)",
      "path": [
        "dist/assets/*.css"
      ],
      "limit": "200 KB"
    }
  ],
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.4.2",
    "html2pdf.js": "^0.12.1",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.6.0",
    "react-hotkeys-hook": "^5.2.1",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.62.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^22.0.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "size-limit": "^13.0.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^1.0.0"
  }
}
